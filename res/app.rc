// 资源：应用图标 + 应用程序清单 + 版本信息
// 图标：Explorer 文件图标（托盘为运行时矢量绘制，同设计）
1 ICON "app.ico"

// RT_MANIFEST：asInvoker（明确声明无需管理员）+ Win10/11 supportedOS + PerMonitorV2 DPI
1 24 "app.manifest"

// VERSIONINFO：资源管理器版本页与杀软启发式友好度（未签名程序的元数据完整性）
1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          0x00040004             // VOS_NT_WINDOWS32
FILETYPE        0x00000001             // VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Emon / TackShot"
      VALUE "FileDescription", "TackShot - lightweight screenshot & pin tool"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "TackShot"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "TackShot.exe"
      VALUE "ProductName", "TackShot"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
